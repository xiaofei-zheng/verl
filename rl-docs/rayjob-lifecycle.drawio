        </mxCell>

        <!-- Step 3: Create RayCluster -->
        <mxCell id="step3" value="&lt;b&gt;创建 RayCluster&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#FFFFFF;strokeColor=#0D47A1;fontSize=13;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="200" height="60" as="geometry" />
