        </mxCell>
        <mxCell id="head_pod" value="&lt;b&gt;Head Pod&lt;/b&gt;&lt;br&gt;ray start --head&lt;br&gt;Dashboard :8265" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
