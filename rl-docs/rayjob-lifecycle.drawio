        </mxCell>
        <mxCell id="ref_w" value="&lt;b&gt;Ref Policy Workers&lt;/b&gt;&lt;br&gt;参考策略计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E65100;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="655" width="140" height="50" as="geometry" />
