        <mxCell id="reward_w" value="&lt;b&gt;Reward&lt;/b&gt;&lt;br&gt;奖励计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E65100;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="655" width="140" height="50" as="geometry" />
