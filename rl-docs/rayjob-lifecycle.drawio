        </mxCell>
        <mxCell id="worker_pod" value="&lt;b&gt;Worker Pod(s)&lt;/b&gt;&lt;br&gt;ray start&lt;br&gt;--address=head:6379" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="215" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Step 4: Wait for cluster ready -->
        <mxCell id="step4" value="&lt;b&gt;等待 RayCluster&lt;/b&gt;&lt;br&gt;状态 Ready" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="200" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Step 5: Create Submitter Pod -->
        <mxCell id="step5" value="&lt;b&gt;生成 Submitter Pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ray job submit&lt;br&gt;--address=http://head:8265&lt;br&gt;-- bash train.sh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#1B5E20;fontSize=12;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="240" y="370" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Step 6: Driver process on head -->
        <mxCell id="step6" value="&lt;b&gt;Head Node 启动 Driver 进程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;执行 entrypoint 脚本&lt;br&gt;export ENV_VARS...&lt;br&gt;python3 -m verl.trainer.main_ppo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#1B5E20;fontSize=12;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="580" y="370" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- Note: env vars only on head -->
        <mxCell id="env_note" value="⚠️ 脚本中 export 的环境变量&lt;br&gt;&lt;b&gt;仅在 Head Node Driver 进程中生效&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="370" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Step 7: verl ray.init -->
        <mxCell id="step7" value="&lt;b&gt;verl 调用 ray.init()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;连接到已有的 Ray 集群&lt;br&gt;（不是新的 submit）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;fontColor=#FFFFFF;strokeColor=#BF360C;fontSize=12;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="240" y="510" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Step 8: Create workers -->
        <mxCell id="step8" value="&lt;b&gt;创建 Ray Worker Actors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ray.remote(TaskRunner)&lt;br&gt;通过 runtime_env 注入&lt;br&gt;WORLD_SIZE, RANK 等&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;fontColor=#FFFFFF;strokeColor=#BF360C;fontSize=12;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="540" y="510" width="220" height="70" as="geometry" />
