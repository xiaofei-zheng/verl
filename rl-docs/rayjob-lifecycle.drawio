        <!-- Step 9: Job completed -->
        <mxCell id="step9" value="&lt;b&gt;训练完成&lt;/b&gt;&lt;br&gt;Job 状态 → SUCCEEDED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;fontColor=#FFFFFF;strokeColor=#1565C0;fontSize=13;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="340" y="770" width="220" height="60" as="geometry" />
